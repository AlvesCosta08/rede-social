<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redireciona tudo que não for arquivo físico para index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# ============================================
# CONFIGURAÇÕES PARA RESOLVER O ERRO DE SESSÃO
# ============================================

# Força o Laravel a usar arquivos para sessões (NÃO banco de dados)
<IfModule mod_env.c>
    SetEnv SESSION_DRIVER file
    SetEnv CACHE_DRIVER file
</IfModule>

# ============================================
# SEGURANÇA - Bloquear arquivos sensíveis
# ============================================

# Bloqueia acesso direto a .env e outros arquivos de configuração
<Files .env>
    Order allow,deny
    Deny from all
</Files>

<Files .env.*>
    Order allow,deny
    Deny from all
</Files>

# Bloqueia arquivos de configuração e cache
<FilesMatch "^(config|composer|package)\.(json|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Bloqueia acesso a pastas internas do Laravel
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# ============================================
# OTIMIZAÇÃO DE PERFORMANCE
# ============================================

# Compressão GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache de arquivos estáticos (imagens, CSS, JS)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
</IfModule>
